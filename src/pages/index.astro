<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111713" />
    <meta
      name="description"
      content="YOBRO ist dein persönlicher Browser für Spaces, fokussiertes Arbeiten und lokale Agenten."
    />
    <meta property="og:title" content="YOBRO — Das Web, aber deins." />
    <meta
      property="og:description"
      content="Ein Browser, der aus Tab-Chaos einen ruhigen, persönlichen Raum macht."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yobro.lol/" />
    <link rel="alternate" hreflang="de" href="https://yobro.lol/" />
    <link rel="alternate" hreflang="en" href="https://yobro.lol/en/" />
    <link rel="alternate" hreflang="x-default" href="https://yobro.lol/" />
    <link rel="icon" href="/assets/favicon.png" />
    <script is:inline src="/language.js"></script>
    <link rel="stylesheet" href="/styles.css?v=20260909e" />
    <title>YOBRO — Das Web, aber deins.</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>

    <header class="nav shell">
      <a class="brand" href="#top" aria-label="YOBRO Startseite">
        <span class="brand-mark"
          ><img src="/assets/yobro-mark.png" alt="" /></span
        ><span>YOBRO</span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="#journey">Tour</a><a href="#principles">Prinzipien</a
        ><a href="#privacy">Privatsphäre</a>
      </nav>
      <div class="nav-actions">
        <a class="language-link" data-language="en" href="/en/">EN</a
        ><a
          class="nav-pill magnetic"
          href="https://github.com/aim0xyz/yobro-site"
          >Preview <span>↗</span></a
        >
      </div>
    </header>

    <main id="top">
      <section class="scroll-story" id="journey" data-scroll-story>
        <div class="story-sticky">
          <video
            class="story-video"
            data-scroll-video
            muted
            playsinline
            preload="auto"
            poster="/assets/yobro-butterfly-horizontal.png"
            aria-hidden="true"
          >
            <source src="/assets/yobro-butterfly-scroll.mp4" type="video/mp4" />
          </video>
          <div class="story-video-wash" aria-hidden="true"></div>
          <div class="story-intro shell" data-story-copy>
            <h1>Das Web.<br /><em>Nur mehr deins.</em></h1>
            <p>Scrolle, um einzutauchen.</p>
          </div>
          <div class="scene-note scene-note-left" aria-hidden="true">
            <span>01</span> YOUR SPACE<br />ON THE WEB
          </div>
          <div class="scene-note scene-note-right" aria-hidden="true">
            SCROLL TO<br />EXPLORE <span>↓</span>
          </div>
          <div class="browser-stage">
            <div class="orbit orbit-a" aria-hidden="true"><i></i></div>
            <div class="orbit orbit-b" aria-hidden="true"><i></i></div>
            <article
              class="browser-shell"
              aria-label="Interaktive Vorschau des YOBRO Browsers"
            >
              <div class="browser-chrome">
                <div class="traffic" aria-hidden="true">
                  <i></i><i></i><i></i>
                </div>
                <div class="history" aria-hidden="true">
                  <span>‹</span><span>›</span>
                </div>
                <div class="address-bar">
                  <span class="lock">●</span
                  ><strong data-address>yobro://home</strong
                  ><span class="refresh">↻</span>
                </div>
                <div class="chrome-actions" aria-hidden="true">
                  <span>⌁</span><span>•••</span>
                </div>
              </div>
              <div class="browser-app">
                <aside class="app-sidebar">
                  <div class="app-brand">
                    <img src="/assets/yobro-mark.png" alt="" /><b>yobro</b
                    ><span>⌄</span>
                  </div>
                  <div class="app-search">
                    <span>⌕</span><span>Suchen</span><kbd>⌘ K</kbd>
                  </div>
                  <p>SPACES</p>
                  <button class="side-item is-active" type="button">
                    <i class="side-dot moss"></i><span>Privat</span
                    ><b>8</b></button
                  ><button class="side-item" type="button">
                    <i class="side-dot orange"></i><span>Studio</span
                    ><b>12</b></button
                  ><button class="side-item" type="button">
                    <i class="side-dot lilac"></i><span>Reise</span><b>6</b>
                  </button>
                  <div class="side-line"></div>
                  <button class="side-item agent-item" type="button">
                    <span>✦</span><span>Lokaler Agent</span><i></i>
                  </button>
                  <div class="app-user">
                    <span>L</span>
                    <div><b>Laura</b><small>Alles lokal</small></div>
                    <i>•••</i>
                  </div>
                </aside>
                <div class="browser-viewport">
                  <div class="browser-feed" data-browser-feed>
                    <section class="browser-panel panel-home" data-panel="0">
                      <div class="panel-topline">
                        <span>DEIN RAUM IM WEB</span><span>BERLIN · 09:41</span>
                      </div>
                      <div class="home-orbit" aria-hidden="true">
                        <i></i><i></i
                        ><span
                          ><img src="/assets/yobro-mark.png" alt=""
                        /></span>
                      </div>
                      <h2>Wohin zieht es<br />dich heute?</h2>
                      <div class="command-box">
                        <span>⌕</span><b>Suchen, öffnen oder fragen</b
                        ><kbd>→</kbd>
                      </div>
                      <div class="quick-links">
                        <span>Neue Idee <i>↗</i></span
                        ><span>Weiterlesen <i>↗</i></span
                        ><span>Deep Focus <i>↗</i></span>
                      </div>
                    </section>
                    <section class="browser-panel panel-spaces" data-panel="1">
                      <div class="panel-label">
                        <span>01</span><b>SPACES</b>
                      </div>
                      <div class="panel-copy">
                        <p>Kontext statt Chaos</p>
                        <h2>Alles an<br />seinem Ort.</h2>
                      </div>
                      <div class="space-deck" aria-hidden="true">
                        <article class="deck-card deck-one">
                          <small>01 / PRIVAT</small><b>Neugier</b
                          ><span>08 offene Wege</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-two">
                          <small>02 / STUDIO</small><b>Build mode</b
                          ><span>12 offene Wege</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-three">
                          <small>03 / REISE</small><b>Unterwegs</b
                          ><span>06 offene Wege</span><i>↗</i>
                        </article>
                      </div>
                    </section>
                    <section class="browser-panel panel-agent" data-panel="2">
                      <div class="panel-label light">
                        <span>02</span><b>LOCAL AGENT</b>
                      </div>
                      <div class="agent-copy">
                        <p>Dein Agent. Dein Rechner.</p>
                        <h2>
                          Zusammen arbeiten.<br /><em
                            >Unter deiner Kontrolle.</em
                          >
                        </h2>
                      </div>
                      <div class="agent-map" aria-hidden="true">
                        <div class="agent-halo halo-one"></div>
                        <div class="agent-halo halo-two"></div>
                        <div class="agent-node">
                          <img src="/assets/yobro-mark.png" alt="" /><span
                            >LOCAL</span
                          >
                        </div>
                        <div class="task-chip task-one">
                          <i>01</i><span>Kontext lesen</span><b>✓</b>
                        </div>
                        <div class="task-chip task-two">
                          <i>02</i><span>Aktion vorbereiten</span><b>✓</b>
                        </div>
                        <div class="task-chip task-three">
                          <i>03</i><span>Du entscheidest</span><b>✓</b>
                        </div>
                      </div>
                    </section>
                    <section class="browser-panel panel-privacy" data-panel="3">
                      <div class="panel-label">
                        <span>03</span><b>PRIVATE BY DESIGN</b>
                      </div>
                      <div class="privacy-lock" aria-hidden="true">
                        <span></span><i></i>
                      </div>
                      <p class="privacy-big">
                        Dein Verlauf ist<br /><em>deine Geschichte.</em>
                      </p>
                      <div class="privacy-status">
                        <span><i></i> Lokal geschützt</span
                        ><span>Agentenzugriff pausierbar</span
                        ><span>Kein Datenzirkus</span>
                      </div>
                    </section>
                  </div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>


      <section class="manifesto shell" id="principles" data-motion-section>
        <p class="section-kicker reveal">Browser neu gedacht</p>
        <div class="manifesto-grid">
          <h2 class="reveal">Nicht noch ein<br />Fenster ins Web.</h2>
          <div class="manifesto-copy reveal">
            <p>Ein ruhigerer Raum <em>für dich.</em></p>
            <span
              >YOBRO ordnet den Browser um deinen Kontext – mit klaren Spaces,
              schnellen Wegen und lokalen Agenten, die nur dann handeln, wenn du
              es willst.</span
            >
          </div>
        </div>
      </section>

      <section class="kinetic" id="motion" data-kinetic data-motion-section aria-label="YOBRO Versprechen">
        <div class="kinetic-sticky">
          <div class="kinetic-lines" aria-hidden="true">
            <p><span>DEIN WEB</span><i>DEIN WEB</i><span>DEIN WEB</span></p>
            <p><i>DEIN RHYTHMUS</i><span>DEIN RHYTHMUS</span><i>DEIN RHYTHMUS</i></p>
            <p><span>DEIN RAUM</span><i>DEIN RAUM</i><span>DEIN RAUM</span></p>
          </div>
        </div>
      </section>

      <section class="principles shell" id="privacy" data-motion-section>
        <article class="principle reveal">
          <span>01</span>
          <div>
            <small>ORIENTIERUNG</small>
            <h3>Spaces merken,<br />wo du warst.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>02</span>
          <div>
            <small>ZUSAMMENARBEIT</small>
            <h3>Agenten helfen,<br />ohne zu übernehmen.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>03</span>
          <div>
            <small>PRIVATSPHÄRE</small>
            <h3>Deine Daten bleiben<br />in deiner Umlaufbahn.</h3>
          </div>
          <i>↗</i>
        </article>
      </section>

      <section class="closing shell" data-motion-section>
        <div class="closing-word" aria-hidden="true">YOBRO</div>
        <div class="closing-orbit" aria-hidden="true">
          <i></i><i></i><img src="/assets/yobro-mark.png" alt="" />
        </div>
        <p class="eyebrow reveal"><span></span> Coming to your Mac</p>
        <h2 class="reveal">Browse like<br /><em>you mean it.</em></h2>
        <a
          class="primary-button magnetic reveal"
          href="https://github.com/aim0xyz/yobro-site"
          >YOBRO verfolgen <span>↗</span></a
        >
      </section>
    </main>

    <footer class="footer shell">
      <a class="brand" href="#top"
        ><span class="brand-mark"
          ><img src="/assets/yobro-mark.png" alt="" /></span
        ><span>YOBRO</span></a
      >
      <p>Made with curiosity by <a href="https://aimoxyz.xyz">aimoxyz</a>.</p>
      <div>
        <a class="language-link" data-language="en" href="/en/">English</a
        ><a href="/privacy/">Datenschutz</a
        ><span>© <span id="year"></span></span>
      </div>
    </footer>
    <script is:inline src="/script.js?v=20260909e"></script>
  </body>
</html>
