    <main id="top">
      <section class="scroll-story" id="journey" data-scroll-story>
        <div class="story-sticky">
          <video
            class="story-video"
            data-scroll-video
            muted
            playsinline
            preload="auto"
            poster="/assets/yobro-butterfly-horizontal.png"
            aria-hidden="true"
          >
            <source src="/assets/yobro-butterfly-scroll.mp4?v=20260910original1" type="video/mp4" />
          </video>
          <div class="story-video-wash" aria-hidden="true"></div>
          <div class="story-intro shell" data-story-copy>
            <h1>The web.<br /><em>Made more yours.</em></h1>
          </div>
          <div class="scene-note scene-note-left" aria-hidden="true">
            <span>01</span> YOUR SPACE<br />ON THE WEB
          </div>
          <div class="scene-note scene-note-right" aria-hidden="true">
            SCROLL TO<br />EXPLORE <span>↓</span>
          </div>
          <div class="browser-stage">
            <div class="orbit orbit-a" aria-hidden="true"><i></i></div>
            <div class="orbit orbit-b" aria-hidden="true"><i></i></div>
            <article
              class="browser-shell"
              aria-label="Interactive preview of the YOBRO browser"
            >
              <div class="browser-app native-browser">
                <aside class="app-sidebar" aria-label="Browser sidebar">
                  <div class="native-window-row" aria-hidden="true">
                    <div class="native-traffic"><i></i><i></i><i></i></div>
                    <div class="native-history"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 8a8 8 0 1 0 0 8M20 3v5h-5"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg></div>
                  </div>
                  <div class="native-brand"><img src="/assets/yobro-mark.png" alt="" /><b>yobro</b><small>PREVIEW</small></div>
                  <div class="native-address"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><span>Search or enter URL</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6z"/></svg><span class="native-actions"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h5m4 0h9M3 12h11m4 0h3M3 18h3m4 0h11"/><circle cx="10" cy="6" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="8" cy="18" r="2"/></svg></span></div>
                  <div class="native-mail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>Email</span><span class="native-mail-count">›</span></div>
                  <div class="native-space-strip"><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/></svg><b>Personal</b><small>1</small><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></div>
                  <div class="native-tab-label"><span>YOUR TABS</span><small>1</small></div>
                  <div class="native-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke-dasharray="1 3"/></svg><span>Spaces</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 7 10 10M7 17 17 7"/></svg></div>
                  <div class="native-new-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>New tab</span><kbd>⌘ T</kbd></div>
                  <div class="native-sidebar-bottom">
                    <div class="native-library"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6m3-3v5l3 2"/></svg>History</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v12m-4-4 4 4 4-4"/></svg>Downloads</span></div>
                    <div class="native-agent"><div><i></i><span>Ready for your agents</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></div><small>One browser. For both of you.</small></div>
                    <div class="native-profile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/></svg><span>Personal</span><small>⌄</small></div>
                  </div>
                </aside>
                <div class="browser-viewport">
                  <div class="browser-feed" data-browser-feed>

                    <section class="browser-panel panel-spaces" data-panel="0">
                      <div class="panel-label">
                        <span>01</span><b>SPACES</b>
                      </div>
                      <div class="panel-copy">
                        <p>Context over chaos</p>
                        <h2>Everything<br />in its place.</h2>
                      </div>
                      <div class="space-deck" aria-hidden="true">
                        <article class="deck-card deck-one">
                          <small>01 / PERSONAL</small><b>Curiosity</b
                          ><span>08 open paths</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-two">
                          <small>02 / STUDIO</small><b>Build mode</b
                          ><span>12 open paths</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-three">
                          <small>03 / TRAVEL</small><b>Out there</b
                          ><span>06 open paths</span><i>↗</i>
                        </article>
                      </div>
                    </section>
                    <section class="browser-panel panel-mail" data-panel="1">
                      <div class="panel-label"><span>02</span><b>YOBRO MAIL</b></div>
                      <div class="mail-story-copy">
                        <h2>Your mail. Right here.</h2>
                        <p>Every inbox in your browser. Turn an email into the next step in your Space.</p>
                      </div>
                      <div class="mail-demo" aria-label="Example view of YOBRO Mail">
                        <div class="mail-demo-toolbar"><b>YOBRO Mail</b><span>New message <i>↗</i></span></div>
                        <div class="mail-demo-layout">
                          <aside class="mail-demo-accounts">
                            <small>MAILBOXES</small>
                            <div class="selected">All inboxes<b>3</b></div>
                            <div>Personal<i></i></div>
                            <div>Studio<i></i></div>
                            <span>Gmail · iCloud<br />IMAP / SMTP</span>
                          </aside>
                          <div class="mail-demo-list">
                            <div class="mail-demo-search">Search messages</div>
                            <article class="selected"><div><b>Mila · Studio</b><time>09:41</time></div><strong>Ready for launch?</strong><small>hello@studio.example</small></article>
                            <article><div><b>Alex</b><time>09:12</time></div><strong>Weekend ideas</strong><small>alex@example.com</small></article>
                            <article><div><b>Design Weekly</b><time>08:30</time></div><strong>A little inspiration</strong><small>news@example.com</small></article>
                          </div>
                          <div class="mail-demo-message">
                            <h3>Ready for launch?</h3>
                            <small>From: Mila · hello@studio.example</small>
                            <p>Hey, the new site is ready. The brief has the final details. Could you take another look?</p>
                            <span class="mail-demo-attachment">↧ &nbsp; Launch-brief.pdf <small>240 KB</small></span>
                            <div class="mail-demo-actions"><span>↶ Reply</span><span>✦ Work in Space</span></div>
                            <div class="mail-demo-agent"><b>✦ Draft a reply</b><span>This email becomes context for your agent.</span></div>
                          </div>
                        </div>
                      </div>
                      <p class="mail-story-footer">Connected directly to your provider. Passwords in Keychain.</p>
                    </section>
                    <section class="browser-panel panel-agent" data-panel="2">
                      <div class="panel-label light">
                        <span>03</span><b>LOCAL AGENT</b>
                      </div>
                      <div class="agent-split">
                        <div class="agent-user-pane">
                          <div class="split-pane-label"><span>YOU</span><i>01</i></div>
                          <p>Your side</p>
                          <h2>You set<br />the intent.</h2>
                          <div class="user-request">
                            <small>YOUR REQUEST</small>
                            <span>Build a launch plan from this research.</span>
                          </div>
                          <div class="approval-note"><i></i><span>Review before action</span><b>IN CONTROL</b></div>
                        </div>
                        <div class="agent-machine-pane">
                          <div class="split-pane-label"><span>YOBRO</span><i>02</i></div>
                          <div class="agent-map" aria-hidden="true">
                            <div class="agent-node">
                              <img src="/assets/yobro-mark.png" alt="" /><span>LOCAL</span>
                            </div>
                            <div class="task-chip task-one"><i>01</i><span>Read context</span><b>✓</b></div>
                            <div class="task-chip task-two"><i>02</i><span>Prepare action</span><b>✓</b></div>
                            <div class="task-chip task-three"><i>03</i><span>You decide</span><b>✓</b></div>
                          </div>
                        </div>
                      </div>
                    </section>
                    <section class="browser-panel panel-privacy" data-panel="3">
                      <div class="panel-label">
                        <span>04</span><b>PRIVATE BY DESIGN</b>
                      </div>
                      <div class="privacy-lock" aria-hidden="true">
                        <span></span><i></i>
                      </div>
                      <p class="privacy-big">
                        Your history is<br /><em>your story.</em>
                      </p>
                      <div class="privacy-status">
                        <span><i></i> Protected locally</span
                        ><span>Agent access is pausable</span
                        ><span>No data circus</span>
                      </div>
                    </section>
                  </div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="manifesto shell" id="principles" data-motion-section>
        <p class="section-kicker reveal">The browser, reconsidered</p>
        <div class="manifesto-grid">
          <h2 class="reveal">Not another<br />window to the web.</h2>
          <div class="manifesto-copy reveal">
            <p>A calmer space <em>for you.</em></p>
            <span
              >YOBRO organizes the browser around your context—with clear
              spaces, shorter paths, and local agents that only act when you
              want them to.</span
            >
          </div>
        </div>
      </section>
      <section class="kinetic" id="motion" data-kinetic data-motion-section aria-label="The YOBRO promise">
        <div class="kinetic-sticky">
          <div class="kinetic-lines" aria-hidden="true">
            <p><span>YOUR WEB</span><i>YOUR WEB</i><span>YOUR WEB</span></p>
            <p><i>YOUR RHYTHM</i><span>YOUR RHYTHM</span><i>YOUR RHYTHM</i></p>
            <p><span>YOUR SPACE</span><i>YOUR SPACE</i><span>YOUR SPACE</span></p>
          </div>
        </div>
      </section>

      <section class="principles shell" id="privacy" data-motion-section>
        <article class="principle reveal">
          <span>01</span>
          <div>
            <small>ORIENTATION</small>
            <h3>Spaces remember<br />where you were.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>02</span>
          <div>
            <small>COLLABORATION</small>
            <h3>Agents help<br />without taking over.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>03</span>
          <div>
            <small>PRIVACY</small>
            <h3>Your data stays<br />in your orbit.</h3>
          </div>
          <i>↗</i>
        </article>
      </section>
      <section class="closing shell" data-motion-section>
        <div class="closing-word" aria-hidden="true">YOBRO</div>
        <div class="closing-orbit" aria-hidden="true">
          <i></i><i></i><img src="/assets/yobro-mark.png" alt="" />
