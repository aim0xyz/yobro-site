<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111713" />
    <meta
      name="description"
      content="YOBRO is your personal browser for spaces, focused work, and local agents."
    />
    <meta property="og:title" content="YOBRO — The web, made yours." />
    <meta
      property="og:description"
      content="A browser that turns tab chaos into a calm, personal space."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yobro.lol/en/" />
    <link rel="alternate" hreflang="de" href="https://yobro.lol/" />
    <link rel="alternate" hreflang="en" href="https://yobro.lol/en/" />
    <link rel="alternate" hreflang="x-default" href="https://yobro.lol/" />
    <link rel="icon" href="/assets/favicon.png" />
    <script is:inline src="/language.js"></script>
    <link rel="stylesheet" href="/styles.css?v=20260909e" />
    <title>YOBRO — The web, made yours.</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>
    <header class="nav shell">
      <a class="brand" href="#top" aria-label="YOBRO home"
        ><span class="brand-mark"
          ><img src="/assets/yobro-mark.png" alt="" /></span
        ><span>YOBRO</span></a
      >
      <nav aria-label="Main navigation">
        <a href="#journey">Tour</a><a href="#principles">Principles</a
        ><a href="#privacy">Privacy</a>
      </nav>
      <div class="nav-actions">
        <a class="language-link" data-language="de" href="/">DE</a
        ><a
          class="nav-pill magnetic"
          href="https://github.com/aim0xyz/yobro-site"
          >Preview <span>↗</span></a
        >
      </div>
    </header>
    <main id="top">
      <section class="scroll-story" id="journey" data-scroll-story>
        <div class="story-sticky">
          <video
            class="story-video"
            data-scroll-video
            muted
            playsinline
            preload="auto"
            poster="/assets/yobro-butterfly-horizontal.png"
            aria-hidden="true"
          >
            <source src="/assets/yobro-butterfly-scroll.mp4" type="video/mp4" />
          </video>
          <div class="story-video-wash" aria-hidden="true"></div>
          <div class="story-intro shell" data-story-copy>
            <h1>The web.<br /><em>Made more yours.</em></h1>
            <p>Scroll to step inside.</p>
          </div>
          <div class="scene-note scene-note-left" aria-hidden="true">
            <span>01</span> YOUR SPACE<br />ON THE WEB
          </div>
          <div class="scene-note scene-note-right" aria-hidden="true">
            SCROLL TO<br />EXPLORE <span>↓</span>
          </div>
          <div class="browser-stage">
            <div class="orbit orbit-a" aria-hidden="true"><i></i></div>
            <div class="orbit orbit-b" aria-hidden="true"><i></i></div>
            <article
              class="browser-shell"
              aria-label="Interactive preview of the YOBRO browser"
            >
              <div class="browser-chrome">
                <div class="chrome-navigation" aria-hidden="true">
                  <span>‹</span><span>›</span><span>↻</span><span>▥</span>
                </div>
                <div class="chrome-title">
                  <img src="/assets/yobro-mark.png" alt="" />
                  <strong>yobro</strong><small>PREVIEW</small>
                </div>
                <div class="chrome-actions" aria-hidden="true">
                  <span>⌘L</span><span>♢</span><span>◈</span><span>☷</span>
                </div>
              </div>
              <div class="browser-app">
                <aside class="app-sidebar">
                  <div class="app-brand">
                    <img src="/assets/yobro-mark.png" alt="" /><b>yobro</b
                    ><span>⌄</span>
                  </div>
                  <div class="app-search">
                    <span>⌕</span><span>Search</span><kbd>⌘ K</kbd>
                  </div>
                  <p>SPACES</p>
                  <button class="side-item is-active" type="button">
                    <i class="side-dot moss"></i><span>Personal</span
                    ><b>8</b></button
                  ><button class="side-item" type="button">
                    <i class="side-dot orange"></i><span>Studio</span
                    ><b>12</b></button
                  ><button class="side-item" type="button">
                    <i class="side-dot lilac"></i><span>Travel</span><b>6</b>
                  </button>
                  <div class="side-line"></div>
                  <button class="side-item agent-item" type="button">
                    <span>✦</span><span>Local agent</span><i></i>
                  </button>
                  <div class="app-user">
                    <span>L</span>
                    <div><b>Laura</b><small>All local</small></div>
                    <i>•••</i>
                  </div>
                </aside>
                <div class="browser-viewport">
                  <div class="browser-feed" data-browser-feed>
                    <section class="browser-panel panel-home" data-panel="0">
                      <div class="panel-topline">
                        <span>YOUR SPACE ON THE WEB</span
                        ><span>BERLIN · 09:41</span>
                      </div>
                      <div class="home-orbit" aria-hidden="true">
                        <i></i><i></i
                        ><span
                          ><img src="/assets/yobro-mark.png" alt=""
                        /></span>
                      </div>
                      <h2>Where are you<br />headed today?</h2>
                      <div class="command-box">
                        <span>⌕</span><b>Search, open, or ask</b><kbd>→</kbd>
                      </div>
                      <div class="quick-links">
                        <span>New idea <i>↗</i></span
                        ><span>Keep reading <i>↗</i></span
                        ><span>Deep focus <i>↗</i></span>
                      </div>
                    </section>
                    <section class="browser-panel panel-spaces" data-panel="1">
                      <div class="panel-label">
                        <span>01</span><b>SPACES</b>
                      </div>
                      <div class="panel-copy">
                        <p>Context over chaos</p>
                        <h2>Everything<br />in its place.</h2>
                      </div>
                      <div class="space-deck" aria-hidden="true">
                        <article class="deck-card deck-one">
                          <small>01 / PERSONAL</small><b>Curiosity</b
                          ><span>08 open paths</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-two">
                          <small>02 / STUDIO</small><b>Build mode</b
                          ><span>12 open paths</span><i>↗</i>
                        </article>
                        <article class="deck-card deck-three">
                          <small>03 / TRAVEL</small><b>Out there</b
                          ><span>06 open paths</span><i>↗</i>
                        </article>
                      </div>
                    </section>
                    <section class="browser-panel panel-agent" data-panel="2">
                      <div class="panel-label light">
                        <span>02</span><b>LOCAL AGENT</b>
                      </div>
                      <div class="agent-split">
                        <div class="agent-user-pane">
                          <div class="split-pane-label"><span>YOU</span><i>01</i></div>
                          <p>Your side</p>
                          <h2>You set<br />the intent.</h2>
                          <div class="user-request">
                            <small>YOUR REQUEST</small>
                            <span>Build a launch plan from this research.</span>
                          </div>
                          <div class="approval-note"><i></i><span>Review before action</span><b>IN CONTROL</b></div>
                        </div>
                        <div class="agent-machine-pane">
                          <div class="split-pane-label"><span>YOBRO</span><i>02</i></div>
                          <div class="agent-map" aria-hidden="true">
                            <div class="agent-node">
                              <img src="/assets/yobro-mark.png" alt="" /><span>LOCAL</span>
                            </div>
                            <div class="task-chip task-one"><i>01</i><span>Read context</span><b>✓</b></div>
                            <div class="task-chip task-two"><i>02</i><span>Prepare action</span><b>✓</b></div>
                            <div class="task-chip task-three"><i>03</i><span>You decide</span><b>✓</b></div>
                          </div>
                        </div>
                      </div>
                    </section>
                    <section class="browser-panel panel-privacy" data-panel="3">
                      <div class="panel-label">
                        <span>03</span><b>PRIVATE BY DESIGN</b>
                      </div>
                      <div class="privacy-lock" aria-hidden="true">
                        <span></span><i></i>
                      </div>
                      <p class="privacy-big">
                        Your history is<br /><em>your story.</em>
                      </p>
                      <div class="privacy-status">
                        <span><i></i> Protected locally</span
                        ><span>Agent access is pausable</span
                        ><span>No data circus</span>
                      </div>
                    </section>
                  </div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="manifesto shell" id="principles" data-motion-section>
        <p class="section-kicker reveal">The browser, reconsidered</p>
        <div class="manifesto-grid">
          <h2 class="reveal">Not another<br />window to the web.</h2>
          <div class="manifesto-copy reveal">
            <p>A calmer space <em>for you.</em></p>
            <span
              >YOBRO organizes the browser around your context—with clear
              spaces, shorter paths, and local agents that only act when you
              want them to.</span
            >
          </div>
        </div>
      </section>
      <section class="kinetic" id="motion" data-kinetic data-motion-section aria-label="The YOBRO promise">
        <div class="kinetic-sticky">
          <div class="kinetic-lines" aria-hidden="true">
            <p><span>YOUR WEB</span><i>YOUR WEB</i><span>YOUR WEB</span></p>
            <p><i>YOUR RHYTHM</i><span>YOUR RHYTHM</span><i>YOUR RHYTHM</i></p>
            <p><span>YOUR SPACE</span><i>YOUR SPACE</i><span>YOUR SPACE</span></p>
          </div>
        </div>
      </section>

      <section class="principles shell" id="privacy" data-motion-section>
        <article class="principle reveal">
          <span>01</span>
          <div>
            <small>ORIENTATION</small>
            <h3>Spaces remember<br />where you were.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>02</span>
          <div>
            <small>COLLABORATION</small>
            <h3>Agents help<br />without taking over.</h3>
          </div>
          <i>↗</i>
        </article>
        <article class="principle reveal">
          <span>03</span>
          <div>
            <small>PRIVACY</small>
            <h3>Your data stays<br />in your orbit.</h3>
          </div>
          <i>↗</i>
        </article>
      </section>
      <section class="closing shell" data-motion-section>
        <div class="closing-word" aria-hidden="true">YOBRO</div>
        <div class="closing-orbit" aria-hidden="true">
          <i></i><i></i><img src="/assets/yobro-mark.png" alt="" />
        </div>
        <p class="eyebrow reveal"><span></span> Coming to your Mac</p>
        <h2 class="reveal">Browse like<br /><em>you mean it.</em></h2>
        <a
          class="primary-button magnetic reveal"
          href="https://github.com/aim0xyz/yobro-site"
          >Follow YOBRO <span>↗</span></a
        >
      </section>
    </main>
    <footer class="footer shell">
      <a class="brand" href="#top"
        ><span class="brand-mark"
          ><img src="/assets/yobro-mark.png" alt="" /></span
        ><span>YOBRO</span></a
      >
      <p>Made with curiosity by <a href="https://aimoxyz.xyz">aimoxyz</a>.</p>
      <div>
        <a class="language-link" data-language="de" href="/">Deutsch</a
        ><a href="/en/privacy/">Privacy</a
        ><span>© <span id="year"></span></span>
      </div>
    </footer>
    <script is:inline src="/script.js?v=20260909e"></script>
  </body>
</html>
